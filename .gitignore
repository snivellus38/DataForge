__pycache__/
*.pyc
node_modules/
.DS_Store
Thumbs.db

# Superseded experiment checkpoints. The JSON results and logs beside them ARE committed --
# they are the experimental record behind the claims in plan.md. Only the shipping
# checkpoint is tracked, because web/public/model.* is derived from it.
research/runs/*.pt
!research/runs/final.pt

# machine-local Claude Code settings
.claude/settings.local.json

# The 8M BDH checkpoints (models/README.md). The WEIGHTS are 443 MB and are published as
# GitHub Release assets, not committed -- `gh release download v1.0-models`. Everything small
# beside them IS tracked: the training notebook, the sparsity-evolution curves, the G* graphs,
# the monosemanticity file and the merge evaluation are the experimental record behind every
# "8M model" number in the artifact, and they are what makes those numbers checkable without
# a 443 MB download. Excluded for size, never for provenance.
models/checkpoints/*.pt

# The prior run's raw per-token dumps: 33 MB of telemetry and 1.2 MB of hero-token frames, kept
# locally as a cross-check (our pipeline independently reproduces its 5.15% sparsity as 5.11%).
# Also released, as prior-run-telemetry.tar.gz.
models/telemetry/telemetry/
models/telemetry/hero_tokens/

# Screen captures, pre-encoding. docs/media/encode.sh turns these into the ~1 MB GIFs the README
# embeds; the multi-megabyte sources stay out of the tree.
docs/media/_originals/

# leftover from an earlier run of research/check_mobile.py, which now uses a temp dir.
# Windows keeps file locks on a browser profile after exit, so this can be undeletable
# for a while; ignoring it rather than fighting it.
research/__mobile_profile/

.vercel
